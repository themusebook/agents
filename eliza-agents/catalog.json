{
  "version": "0.1.3",
  "product": "cheshireterminal.ai/eliza-agents",
  "elizaFork": "https://github.com/Solizardking/eliza",
  "agentsRepo": "https://github.com/Solizardking/agents",
  "cliRepo": "https://github.com/Solizardking/cli",
  "cheshireTerminalRepo": "https://github.com/Solizardking/cheshire-terminal",
  "openSource": {
    "productHubs": {
      "agents": "https://cheshireterminal.ai/agents",
      "elizaAgents": "https://cheshireterminal.ai/eliza-agents",
      "cli": "https://cheshireterminal.ai/cli"
    },
    "github": {
      "agents": "https://github.com/Solizardking/agents",
      "cli": "https://github.com/Solizardking/cli",
      "eliza": "https://github.com/Solizardking/eliza",
      "cheshireTerminal": "https://github.com/Solizardking/cheshire-terminal"
    },
    "repos": [
      {
        "id": "agents",
        "url": "https://github.com/Solizardking/agents",
        "role": "Agent catalog definitions + forge scaffolds",
        "siteHub": "/agents"
      },
      {
        "id": "cli",
        "url": "https://github.com/Solizardking/cli",
        "role": "Official site CLI (cheshire-terminal-cli)",
        "siteHub": "/cli"
      },
      {
        "id": "eliza",
        "url": "https://github.com/Solizardking/eliza",
        "role": "elizaOS fork + cheshire-eliza",
        "siteHub": "/eliza-agents"
      },
      {
        "id": "cheshire-terminal",
        "url": "https://github.com/Solizardking/cheshire-terminal",
        "role": "Main product app",
        "siteHub": "/"
      }
    ]
  },
  "knowledge": {
    "plugin": "@elizaos/plugin-knowledge",
    "docs": "https://docs.elizaos.ai/plugin-registry/knowledge",
    "quickStart": "https://docs.elizaos.ai/plugin-registry/knowledge/quick-start",
    "localGuide": "docs/KNOWLEDGE_RAG.md",
    "packageCorpus": "../knowledge",
    "zkDocs": "../zk-primitives/docs",
    "cli": {
      "init": "ct-agents knowledge init --from clawd --out ./my-knowledge",
      "upload": "ct-agents knowledge upload <files> --out ./my-knowledge",
      "elizaDocs": "ct-agents knowledge eliza-docs --from knowledge --out ./docs",
      "inject": "ct-agents knowledge inject ./my-knowledge"
    },
    "env": [
      "OPENAI_API_KEY",
      "LOAD_DOCS_ON_STARTUP",
      "KNOWLEDGE_PATH",
      "CTX_KNOWLEDGE_ENABLED"
    ]
  },
  "relatedPackages": {
    "zkPrimitives": "../zk-primitives",
    "knowledge": "../knowledge",
    "characters": "../characters"
  },
  "plugins": [
    {
      "name": "@elizaos/plugin-knowledge",
      "path": "npm:@elizaos/plugin-knowledge",
      "capabilities": [
        "rag",
        "document-upload",
        "semantic-search",
        "load-docs-on-startup"
      ],
      "env": [
        "OPENAI_API_KEY",
        "LOAD_DOCS_ON_STARTUP",
        "KNOWLEDGE_PATH",
        "CTX_KNOWLEDGE_ENABLED"
      ],
      "docs": "https://docs.elizaos.ai/plugin-registry/knowledge"
    },
    {
      "name": "@elizaos/plugin-robinhood",
      "path": "plugins/plugin-robinhood",
      "capabilities": [
        "erc-8004",
        "robinhood-forge"
      ]
    },
    {
      "name": "@elizaos/plugin-solana-forging",
      "path": "plugins/plugin-solana-forging",
      "capabilities": [
        "metaplex-core",
        "solana-forge"
      ]
    },
    {
      "name": "@elizaos/plugin-e2b-computer",
      "path": "plugins/plugin-e2b-computer",
      "capabilities": [
        "e2b-sandbox",
        "computer"
      ]
    },
    {
      "name": "@elizaos/plugin-cheshire-memory",
      "path": "plugins/plugin-cheshire-memory",
      "capabilities": [
        "hermes",
        "honcho",
        "trading-memory"
      ],
      "env": [
        "HERMES_API_KEY",
        "HONCHO_API_KEY"
      ]
    }
  ],
  "characters": [
    {
      "id": "alice",
      "file": "alice-character-json.json"
    },
    {
      "id": "bengraham",
      "file": "bengraham.json"
    },
    {
      "id": "billackman",
      "file": "billackman.json"
    },
    {
      "id": "cathiewood",
      "file": "cathiewood.json"
    },
    {
      "id": "charliemunger",
      "file": "charliemunger.json"
    },
    {
      "id": "cheshire",
      "file": "cheshire-character-json.json"
    },
    {
      "id": "clawd",
      "file": "clawd.json"
    },
    {
      "id": "hedgefund",
      "file": "hedgefund.json"
    },
    {
      "id": "mad-hatter",
      "file": "mad-hatter-character-json.json"
    },
    {
      "id": "solizard-cheshire",
      "file": "solizard-eliza.json"
    },
    {
      "id": "warrenbuffet",
      "file": "warrenbuffet.json"
    },
    {
      "id": "elizero",
      "file": "elizero.json",
      "note": "first eliza Zero agent powered by $CLAWD"
    },
    {
      "id": "hedgedna",
      "file": "hedgedna.json",
      "notes": "eliZERO-class Clawd hedge spawn from hedge-dna"
    }
  ],
  "packs": {
    "perps": "clawd-agents-perps (cheshire-terminal)",
    "defiLocales": "defi-agents/locales (cheshire-terminal)"
  }
}
