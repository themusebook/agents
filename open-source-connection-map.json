{
  "version": "1.2.0",
  "description": "Canonical OSS ↔ product hub connection map for cheshire-terminal-agents. Product hubs include /agents, /cli, /eliza-agents, /skills, /skills-store, /arena, /registry, /mcp. Local cheshire-terminal-main surfaces are resolved when present (not vendored). ACP + A2A live in this package.",
  "productHubs": {
    "agents": "https://cheshireterminal.ai/agents",
    "elizaAgents": "https://cheshireterminal.ai/eliza-agents",
    "cli": "https://cheshireterminal.ai/cli",
    "skills": "https://cheshireterminal.ai/skills",
    "skillsStore": "https://cheshireterminal.ai/skills-store",
    "arena": "https://cheshireterminal.ai/arena",
    "registry": "https://cheshireterminal.ai/registry",
    "mcp": "https://cheshireterminal.ai/mcp"
  },
  "github": {
    "agents": "https://github.com/Solizardking/agents",
    "cli": "https://github.com/Solizardking/cli",
    "eliza": "https://github.com/Solizardking/eliza",
    "cheshireTerminal": "https://github.com/Solizardking/cheshire-terminal",
    "skills": "https://github.com/Solizardking/skills",
    "skillhub": "https://github.com/Solizardking/skillhub-main",
    "robinhoodAgents": "https://github.com/Solizardking/robinhood-agents"
  },
  "local": {
    "skillhub": "../skillhub-main",
    "skillsDir": "../skillhub-main/skills",
    "env": "CLAWD_SKILLHUB_ROOT",
    "robinhoodAgents": "../cheshire-terminal-main/robinhood-agents",
    "robinhoodAgentsEnv": "CLAWD_ROBINHOOD_AGENTS_ROOT",
    "cheshireTerminal": "../cheshire-terminal-main",
    "cheshireTerminalEnv": "CLAWD_CHESHIRE_TERMINAL_ROOT",
    "membrain": "packages/membrain",
    "membrainEnv": "MEMBRAIN_HTTP_URL",
    "surfaces": {
      "skills": "../cheshire-terminal-main/skills",
      "skillsStore": "../cheshire-terminal-main/skills-store",
      "agents": "../cheshire-terminal-main/agents",
      "client": "../cheshire-terminal-main/client",
      "mcpServer": "../cheshire-terminal-main/mcp-server",
      "registry": "../cheshire-terminal-main/registry",
      "robinhoodAgents": "../cheshire-terminal-main/robinhood-agents",
      "agentArena": "../cheshire-terminal-main/agent-arena",
      "agentArenaSkill": "../cheshire-terminal-main/agent-arena-skill",
      "cli": "../cheshire-terminal-main/cli"
    }
  },
  "protocols": {
    "acp": {
      "wellKnown": "https://cheshireterminal.ai/.well-known/acp.json",
      "local": "public/.well-known/acp.json",
      "cli": "ct-agents acp"
    },
    "a2a": {
      "elizero": "https://cheshireterminal.ai/a2a/elizero",
      "zkShark": "https://cheshireterminal.ai/a2a/zk-shark",
      "productCard": "https://cheshireterminal.ai/.well-known/agent-card.json",
      "cli": "ct-agents a2a"
    }
  },
  "links": {
    "agentsToSkills": {
      "from": "https://cheshireterminal.ai/agents",
      "to": "https://cheshireterminal.ai/skills",
      "githubFrom": "https://github.com/Solizardking/agents",
      "githubTo": "https://github.com/Solizardking/skills"
    }
  },
  "repos": [
    {
      "id": "agents",
      "url": "https://github.com/Solizardking/agents",
      "role": "Agent catalog definitions + forge scaffolds",
      "siteHub": "/agents",
      "npm": "cheshire-terminal-agents"
    },
    {
      "id": "cli",
      "url": "https://github.com/Solizardking/cli",
      "role": "Official site CLI (status, skills, eliza:*, registry, arena)",
      "siteHub": "/cli",
      "npm": "cheshire-terminal-cli"
    },
    {
      "id": "eliza",
      "url": "https://github.com/Solizardking/eliza",
      "role": "elizaOS fork + cheshire-eliza character/body generator",
      "siteHub": "/eliza-agents",
      "package": "@elizaos/cheshire-eliza"
    },
    {
      "id": "cheshire-terminal",
      "url": "https://github.com/Solizardking/cheshire-terminal",
      "role": "Main product app (server, client, API, hub pages)",
      "siteHub": "/"
    },
    {
      "id": "skills",
      "url": "https://github.com/Solizardking/skills",
      "role": "Skill Hub installer (npx github:Solizardking/skills install <slug>)",
      "siteHub": "/skills"
    },
    {
      "id": "skillhub-main",
      "url": "https://github.com/Solizardking/skillhub-main",
      "role": "Full Skill Hub catalog (~595 SKILL.md bodies). Local checkout: ../skillhub-main/skills",
      "siteHub": "/skills"
    },
    {
      "id": "robinhood-agents",
      "url": "https://github.com/Solizardking/robinhood-agents",
      "role": "Dual-rail forge SDK, ERC-8004 registries, RH skills, zk-omni. Local: ../cheshire-terminal-main/robinhood-agents",
      "siteHub": "/agents/forge",
      "npm": "cheshire-terminal-agents"
    }
  ]
}
